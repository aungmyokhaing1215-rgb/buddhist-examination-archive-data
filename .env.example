# GitHub repository that stores the permanent JSON archive
GITHUB_TOKEN=replace_with_fine_grained_repository_token
GITHUB_OWNER=your-account
GITHUB_REPO=buddhist-examination-archive-data
GITHUB_BRANCH=main
GITHUB_DATA_PATH=data

# Use a long random value (at least 32 bytes); never expose in VITE_* vars
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace_with_long_random_secret_at_least_32_bytes
